// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Aligned with Database Standards)
// ==========================================

enum UserRole {
  ADMIN
  OPERATOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum CustomerType {
  REGISTERED
  VOUCHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum RouterType {
  MIKROTIK
  OPENWRT
  OTHER
}

enum RouterStatus {
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum PackageType {
  TIME
  DATA
  UNLIMITED
  HYBRID
  PROMOTIONAL
}

enum PackageStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum VoucherStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MPESA
  AIRTEL_MONEY
  TIGOPESA
  HALOPESA
  BANK
  CARD
  CASH
}

enum TransactionStatus {
  PENDING
  VERIFIED
  SUCCESS
  FAILED
  CANCELLED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT
  VOUCHER
  ROUTER
  SESSION
  SYSTEM
}

enum AuditEntity {
  USER
  CUSTOMER
  PACKAGE
  SUBSCRIPTION
  PAYMENT
  TRANSACTION
  VOUCHER
  ROUTER
  SESSION
  SYSTEM
}

enum SettingType {
  GENERAL
  PAYMENT
  ROUTER
  EMAIL
  SMS
  SECURITY
}

enum DurationUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
}

enum Gender {
  MALE
  FEMALE
}

enum Currency {
  TZS
  USD
}

// ==========================================
// MODELS
// ==========================================

model User {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique
  phone    String?    @unique
  password String
  role     UserRole   @default(CUSTOMER)
  status   UserStatus @default(ACTIVE)

  customer          Customer?
  auditLogs         AuditLog[]
  generatedVouchers Voucher[]
  receivedPayments  Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete Policy

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model Customer {
  id           String         @id @default(uuid())
  customerCode String         @unique
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id])

  customerType CustomerType
  status       CustomerStatus @default(ACTIVE)
  fullName     String
  email        String?
  phone        String?
  address      String?
  nationalId   String?
  dateOfBirth  DateTime?
  gender       Gender?
  notes        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete Policy

  sessions      Session[]
  payments      Payment[]
  subscriptions Subscription[]

  @@index([customerCode])
  @@index([status])
  @@index([customerType])
  @@map("customers")
}

model Router {
  id                String       @id @default(uuid())
  name              String       @unique
  type              RouterType   @default(MIKROTIK)
  ipAddress         String
  apiPort           Int          @default(8728)
  username          String
  passwordEncrypted String
  location          String?
  status            RouterStatus @default(OFFLINE)
  lastSeen          DateTime?
  routerVersion     String?
  modelName         String?
  serialNumber      String?
  identity          String?
  lastSyncAt        DateTime?
  isDefault         Boolean      @default(false)

  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete Policy

  @@unique([ipAddress, apiPort])
  @@index([status])
  @@index([lastSeen])
  @@index([ipAddress])
  @@map("routers")
}

model Package {
  id                String        @id @default(uuid())
  name              String        @unique
  description       String?
  type              PackageType
  price             Decimal       @db.Decimal(12, 2)
  duration          Int
  validityUnit      DurationUnit  @default(DAY)
  downloadSpeedMbps Int?
  uploadSpeedMbps   Int?
  dataLimitGB       Float?
  deviceLimit       Int           @default(1)
  status            PackageStatus @default(ACTIVE)
  priority          Int           @default(0)
  sortOrder         Int           @default(0)

  subscriptions Subscription[]
  vouchers      Voucher[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete Policy

  @@index([status])
  @@index([price])
  @@index([type])
  @@map("packages")
}

model Subscription {
  id           String             @id @default(uuid())
  customerId   String?            // Optional for pure voucher users
  packageId    String
  voucherId    String?            // Optional for account-based users
  
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  package      Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  voucher      Voucher?           @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  startDate    DateTime
  endDate      DateTime
  activatedAt  DateTime?
  expiredAt    DateTime?
  status       SubscriptionStatus @default(PENDING)
  autoRenew    Boolean            @default(false)

  payments     Payment[]
  sessions     Session[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // No deletedAt: Historical subscription records must be preserved

  @@index([customerId])
  @@index([packageId])
  @@index([voucherId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

model Voucher {
  id            String        @id @default(uuid())
  code          String        @unique @db.VarChar(30)
  packageId     String
  generatedById String?
  
  package       Package       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  generatedBy   User?         @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  status        VoucherStatus @default(ACTIVE) // Standard: ACTIVE, not GENERATED
  expiresAt     DateTime?
  usedAt        DateTime?
  batchNumber   String?
  printed       Boolean       @default(false)
  printedAt     DateTime?

  session       Session?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete Policy
 subscriptions Subscription[] 
  @@index([expiresAt])
  @@index([code])
  @@index([status])
  @@index([batchNumber])
  @@map("vouchers")
}

model Payment {
  id             String          @id @default(uuid())
  customerId     String
  subscriptionId String?
  
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amount         Decimal         @db.Decimal(12, 2)
  currency       Currency        @default(TZS)
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)

  paidAt           DateTime?
  receiptNumber    String?       @unique
  paymentReference String?
  providerPhone    String?
  notes            String?

  receivedById String?
  receivedBy   User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  transaction  Transaction?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete Policy

  @@index([provider])
  @@index([paidAt])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model Transaction {
  id                String            @id @default(uuid())
  paymentId         String            @unique
  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  providerReference String            @unique
  externalReference String?
  status            TransactionStatus @default(PENDING)
  callbackPayload   Json?
  verifiedAt        DateTime?
  processedAt       DateTime?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // No deletedAt: Financial records must be immutable and preserved

  @@index([providerReference])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model Session {
  id             String        @id @default(uuid())
  customerId     String?       // Optional for voucher users
  subscriptionId String?       // Optional, but recommended
  voucherId      String?       @unique
  routerId       String?       // Optional in case router is unknown at login

  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  voucher        Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  router         Router?       @relation(fields: [routerId], references: [id], onDelete: SetNull)

  username       String?
  nasPort        String?
  sessionId      String?
  macAddress     String?
  callerId       String?
  terminateCause String?
  sessionTime    Int           @default(0)
  ipAddress      String?
  loginTime      DateTime      @default(now())
  logoutTime     DateTime?

  uploadBytes      BigInt        @default(0)
  downloadBytes    BigInt        @default(0)
  totalBytes       BigInt        @default(0)
  disconnectReason String?       // Tracks why session ended (e.g., "MANUAL_DISCONNECT")
  status           SessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // No deletedAt: Usage history must be preserved for reporting

  @@index([loginTime])
  @@index([logoutTime])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([voucherId])
  @@index([routerId])
  @@index([status])
  @@index([macAddress])
  @@map("sessions")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      AuditAction
  entity      AuditEntity
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  oldValues   Json?
  newValues   Json?
  module      String?
  success     Boolean     @default(true)

  createdAt DateTime @default(now())
  // No deletedAt: Audit logs are immutable

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       Json
  description String?
  type        SettingType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("system_settings")
}